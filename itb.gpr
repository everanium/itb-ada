--  itb.gpr — Ada binding library project for libitb.
--
--  Builds the thin-proxy wrapper sources under src/ and exposes the
--  linker switches needed for any consumer (test driver, bench
--  binaries, eitb, user programs) to link against libitb.so.
--  Consumers `with "itb";` and inherit the linker options
--  automatically.
--
--  Library search resolution at link time:
--    - Compile-time: -L${ITB_DIST_DIR} (default ../../dist/linux-amd64
--      relative to this .gpr).
--    - Runtime: -Wl,-rpath,$ORIGIN/../../../dist/linux-amd64 — the
--      binary searches the canonical dist/ subfolder relative to its
--      own location, so no LD_LIBRARY_PATH setup is needed for the
--      canonical bindings/ada/obj-tests/ / obj-bench/ / eitb/
--      layouts. Binaries installed outside this layout need libitb.so
--      on a system loader path or LD_LIBRARY_PATH set.

project Itb is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Languages use ("Ada");

   --  Path to the libitb shared-library distribution. Override with
   --  `gprbuild -XITB_DIST_DIR=/abs/path` for installs where
   --  libitb.so lives elsewhere.
   Dist_Dir := external ("ITB_DIST_DIR", "../../dist/linux-amd64");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",      --  Ada 2022 mode.
         "-gnatwa",        --  All warnings on (audit-grade build).
         "-gnatVa",        --  All validity checks.
         "-gnatwe",        --  Warnings as errors.
         "-O2",            --  Optimisation level for FFI hot path.
         "-g");            --  Debug info for crash diagnosis.
   end Compiler;

   --  Linker_Options propagate to every consumer that withs this
   --  project. Builds may emit a cosmetic non-fatal ".sframe" linker
   --  notice when the Alire-bundled binutils meets a system glibc
   --  Scrt1.o with an older-format .sframe section; build.sh filters
   --  it out of human-facing output.
   package Linker is
      for Linker_Options use
        ("-L" & Dist_Dir,
         "-litb",
         "-Wl,-rpath,$ORIGIN/../../../dist/linux-amd64");
   end Linker;

   package Builder is
      for Default_Switches ("Ada") use ("-j0");  --  Use all cores.
   end Builder;

end Itb;
